.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
data/lanl/raw/*.gz
!data/lanl/raw/sample_auth.txt.gz
data/lanl/staged/
data/lanl/simulated/
data/mordor/
# Root-anchored (not a bare `logs/`) so it only ignores this repo's own
# audit-log output directory (scripts/run_pipeline.py's default
# `logs/audit.log`) and doesn't shadow `frontend/src/features/logs/`
# (Milestone F11's Log Explorer) or any other nested `logs` directory.
/logs/

# Local Claude Code tooling (skills/config auto-installed into this repo's
# .claude/ directory) -- editor/agent tooling config, not project source.
.claude/

# Generated CLI report/output artifacts -- pilot.py/score_entities.py/
# calibrate_decay.py's --output has no fixed default, so these are just the
# filenames used in local dev runs; root-anchored so they don't shadow any
# same-named file nested under config/ or data/.
/scores.json
/pilot-report.json
/calibration-report.json
/mordor-scores.json
