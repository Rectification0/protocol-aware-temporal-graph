# Local Postgres dev database -- see CLAUDE.md "Local dev database" section.
# Copy this file to .env and fill in your local credentials -- do not commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=t_gnn_dev
PGUSER=postgres
PGPASSWORD=changeme

# Local Neo4j (docker-compose.yml's neo4j service) -- cold storage write path
# (tasks.md 2.4). Password below matches docker-compose.yml's NEO4J_AUTH
# dev default; still don't put a real/production credential in this file.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword123
