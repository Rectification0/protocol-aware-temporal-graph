# Copy this file to .env.local and edit for your local setup -- .env.local
# is gitignored (see Vite's default .gitignore in this folder), mirroring
# the root repo's .env/.env.example convention for the Python backend.
#
# Base URL of the t_gnn backend API service (src/t_gnn/api/, tasks.md
# Milestone F0). Run `python -m t_gnn.api` from the repo root -- it listens
# on 127.0.0.1:8000 by default.
VITE_API_BASE_URL=http://127.0.0.1:8000

# F3.4: mock-auth bypass -- real backend auth (tasks.md F0.11) doesn't
# exist yet. Defaults to enabled (true) when unset; set to "false" only to
# see the login page's honest "auth unavailable" state.
# VITE_MOCK_AUTH_ENABLED=true
